# OpenAI-compatible endpoint.
# OpenCode Go: https://opencode.ai/zen/go/v1
LLM_BASE_URL=https://opencode.ai/zen/go/v1

# Provider API key.
LLM_API_KEY=

# Model id for the chosen provider.
# OpenCode Go examples: kimi-k2.7-code, deepseek-v4-flash, glm-5.2
LLM_MODEL=kimi-k2.7-code

# Tool permissions: prompt (ask each time), allow (auto-approve), deny.
# Defaults to prompt on a TTY and deny when stdin is piped.
TOOL_PERMISSIONS=prompt

# Write a JSONL transcript under .coding-agent/sessions/ when set to 1.
# SESSION_LOG=1
